rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user can read/write while the app is in prototype stage.
    // Tighten with role-based checks (users/{uid}.role) before real deployment.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
